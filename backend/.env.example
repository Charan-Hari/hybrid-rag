# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it is gitignored.

# --- App ---
ENVIRONMENT=development
CORS_ALLOW_ORIGINS=*

# --- Security ---
# Optional. Leave blank for a frictionless demo; set this only when the
# backend is behind a trusted authentication layer or private deployment.
API_KEY=
RATE_LIMIT_PER_MINUTE=30

# --- Storage ---
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./data/uploads
COLLECTION_NAME=documents
MAX_UPLOAD_MB=20

# --- Embeddings ---
EMBEDDING_DIMENSION=384

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
TOP_K_DENSE=8
TOP_K_SPARSE=8
TOP_K_FINAL=5
USE_RERANKER=false
MIN_RELEVANCE_SCORE=0.15

# --- LLM provider: "groq" or "gemini" ---
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
